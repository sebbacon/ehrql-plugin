#!/usr/bin/env bash
set -euo pipefail

if [ "$1 $2" = "auth status" ]; then
    exit 0
fi
if [ "$1 $2" = "repo create" ]; then
    git clone -q "$FAKE_TEMPLATE" "$FAKE_SEED"
    git clone -q --bare "$FAKE_SEED" "$FAKE_REMOTE"
    exit 0
fi
if [ "$1 $2" = "repo clone" ]; then
    git clone -q "$FAKE_REMOTE" "$4"
    exit 0
fi
printf 'unexpected gh invocation: %s\n' "$*" >&2
exit 1
